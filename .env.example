# ==============================================================================
# SUPABASE DATABASE CONFIGURATION (REQUIRED)
# ==============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_TABLE_NAME=creators

# Frontend compatibility (Next.js / React)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-service-role-key

# ==============================================================================
# AI EMAIL GENERATION (OPENAI API)
# ==============================================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# EMAIL DISPATCH CONFIGURATION (FREE TIER / CUSTOM GODADDY DOMAIN)
# ==============================================================================
# Option 1: Resend API (Recommended - 3,000 free emails/month)
RESEND_API_KEY=re_your_resend_api_key_here

# Option 2: Custom SMTP / GoDaddy Mail Server
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=contact@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_SECURE=false

# Default Sender Identity
SENDER_NAME=Collab Team
SENDER_EMAIL=collab@yourdomain.com

# Default Signature Information
DEFAULT_SIGNATURE_NAME=Brand Partnerships Lead
DEFAULT_SIGNATURE_BRAND=Your Brand Name
DEFAULT_SIGNATURE_WEBSITE=https://yourbrand.com
DEFAULT_SIGNATURE_PHONE=+1 (555) 123-4567

# ==============================================================================
# SCRAPER & FILTER CONFIGURATIONS (OPTIONAL)
# ==============================================================================
DEFAULT_MIN_FOLLOWERS=5000
DEFAULT_MAX_FOLLOWERS=50000
DEFAULT_LOCATION_ID=204821
DEFAULT_CATEGORY=Lifestyle
DEFAULT_PLATFORM=instagram

# ==============================================================================
# THIRD-PARTY ENRICHMENT API KEYS (OPTIONAL)
# ==============================================================================
INFLUENCERS_CLUB_TOKEN=
